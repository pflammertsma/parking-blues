.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# GCP service account keys -- never commit these.
*-deployer-key.json
*.json.key
service-account*.json

# Android / Kotlin Multiplatform (android/)
android/**/build/
android/.gradle/
android/local.properties
android/.idea/
android/**/*.iml
android/**/.cxx/
android/captures/
android/**/.kotlin/

# Android release signing: keystore and its passwords. Never commit; back up
# android/keystore/ somewhere private (e.g. Google Drive).
android/keystore/
*.jks
*.keystore
keystore.properties
